
pipeline {

    agent any

    environment {

        DEV_REGISTRY =
            "docker.io/payalkharat/jenkins-backend-dev"

        QA_REGISTRY =
            "docker.io/payalkharat/jenkins-backend-qa"

        STAGE_REGISTRY =
            "docker.io/payalkharat/jenkins-backend-stage"

        PROD_REGISTRY =
            "docker.io/payalkharat/jenkins-backend-prod"


        EKS_CLUSTER = "cluster-1"
        AWS_REGION  = "us-east-1"


        DEV_NAMESPACE   = "dev"
        QA_NAMESPACE    = "qa"
        STAGE_NAMESPACE = "uat"
        PROD_NAMESPACE  = "prod"


        DEV_DOCKER_CREDS   = "dh_cred_dev"
        QA_DOCKER_CREDS    = "dh_cred_qa"
        STAGE_DOCKER_CREDS = "dh_cred_stage"
        PROD_DOCKER_CREDS  = "dh_cred_prod"
    }


    stages {

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()

                    echo "======================================"
                    echo "COMMIT ID: ${env.COMMIT_ID}"
                    echo "======================================"
                }
            }
        }


        stage('Connect to EKS') {

            steps {

                sh """
                    aws eks update-kubeconfig \
                        --name ${EKS_CLUSTER} \
                        --region ${AWS_REGION}

                    kubectl get nodes
                """
            }
        }


        stage('Docker Login') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'Docker-hub-id',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            docker.io \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin
                    '''
                }
            }
        }


        stage('Build Backend Image') {

            steps {

                script {

                    def image =
                        "${DEV_REGISTRY}:${COMMIT_ID}"

                    sh """
                        docker build \
                            -f APP-2/nginx-golang-mysql/backend/Dockerfile \
                            -t ${image} \
                            APP-2/nginx-golang-mysql/backend/

                        docker push ${image}
                    """

                    echo "======================================"
                    echo "BACKEND IMAGE BUILT AND PUSHED"
                    echo "IMAGE: ${image}"
                    echo "======================================"
                }
            }
        }


        stage('Deploy Backend - DEV') {

            steps {

                script {

                    deployBackend(
                        DEV_NAMESPACE,
                        DEV_REGISTRY,
                        "APP-2/kube/backend-deployment.yaml",
                        "APP-2/kube/backend-service.yaml"
                    )
                }
            }
        }


        stage('Promote Backend DEV → QA') {

            steps {

                script {

                    promoteImage(
                        "${DEV_REGISTRY}:${COMMIT_ID}",
                        "${QA_REGISTRY}:${COMMIT_ID}",
                        DEV_DOCKER_CREDS,
                        QA_DOCKER_CREDS
                    )
                }
            }
        }


        stage('Deploy Backend - QA') {

            steps {

                script {

                    deployBackend(
                        QA_NAMESPACE,
                        QA_REGISTRY,
                        "APP-2/kube/backend-deployment.yaml",
                        "APP-2/kube/backend-service.yaml"
                    )
                }
            }
        }


        stage('Promote Backend QA → STAGE') {

            steps {

                script {

                    promoteImage(
                        "${QA_REGISTRY}:${COMMIT_ID}",
                        "${STAGE_REGISTRY}:${COMMIT_ID}",
                        QA_DOCKER_CREDS,
                        STAGE_DOCKER_CREDS
                    )
                }
            }
        }


        stage('Deploy Backend - STAGE') {

            steps {

                script {

                    deployBackend(
                        STAGE_NAMESPACE,
                        STAGE_REGISTRY,
                        "APP-2/kube/backend-deployment.yaml",
                        "APP-2/kube/backend-service.yaml"
                    )
                }
            }
        }


        stage('Production Approval') {

            steps {

                input(
                    message: "Deploy Backend ${COMMIT_ID} to PROD?",
                    ok: "Deploy Backend to PROD"
                )
            }
        }


        stage('Promote Backend STAGE → PROD') {

            steps {

                script {

                    promoteImage(
                        "${STAGE_REGISTRY}:${COMMIT_ID}",
                        "${PROD_REGISTRY}:${COMMIT_ID}",
                        STAGE_DOCKER_CREDS,
                        PROD_DOCKER_CREDS
                    )
                }
            }
        }


        stage('Deploy Backend - PROD') {

            steps {

                script {

                    deployBackend(
                        PROD_NAMESPACE,
                        PROD_REGISTRY,
                        "APP-2/kube/backend-deployment.yaml",
                        "APP-2/kube/backend-service.yaml"
                    )
                }
            }
        }
    }


    post {

        always {

            echo "Cleaning Jenkins workspace..."

            cleanWs()
        }
    }
}


/* =========================================================
   BACKEND DEPLOYMENT FUNCTION
   ========================================================= */

def deployBackend(
    String namespace,
    String registry,
    String deploymentYaml,
    String serviceYaml
) {

    def image =
        "${registry}:${env.COMMIT_ID}"

    echo "======================================"
    echo "DEPLOYING BACKEND"
    echo "======================================"
    echo "Namespace : ${namespace}"
    echo "Image     : ${image}"
    echo "======================================"


    echo "Applying Backend Deployment..."

    sh """
        kubectl apply \
            -f ${deploymentYaml} \
            -n ${namespace}
    """


    echo "Applying Backend Service..."

    sh """
        kubectl apply \
            -f ${serviceYaml} \
            -n ${namespace}
    """


    echo "Updating Backend Image..."

    sh """
        kubectl -n ${namespace} set image \
            deployment/backend \
            backend=${image}
    """


    echo "Waiting for Backend Rollout..."

    sh """
        kubectl -n ${namespace} rollout status \
            deployment/backend \
            --timeout=180s
    """


    echo "Backend Deployment Status:"

    sh """
        kubectl get deployment backend \
            -n ${namespace}

        kubectl get service app2-backend \
            -n ${namespace}

        kubectl get pods \
            -n ${namespace}
    """


    echo "======================================"
    echo "BACKEND DEPLOYMENT COMPLETED"
    echo "Namespace : ${namespace}"
    echo "Image     : ${image}"
    echo "======================================"
}

/* =========================================================
   IMAGE PROMOTION FUNCTION
   ========================================================= */

def promoteImage(
    String sourceImage,
    String targetImage,
    String sourceCredentials,
    String targetCredentials
) {

    echo "======================================"
    echo "IMAGE PROMOTION"
    echo "======================================"
    echo "Source : ${sourceImage}"
    echo "Target : ${targetImage}"
    echo "======================================"


    /*
     * LOGIN TO SOURCE REGISTRY
     * Pull the already-built image.
     */

    withCredentials([
        usernamePassword(
            credentialsId: sourceCredentials,
            usernameVariable: 'DOCKER_USERNAME',
            passwordVariable: 'DOCKER_PASSWORD'
        )
    ]) {

        sh """
            echo "\$DOCKER_PASSWORD" | docker login \
                docker.io \
                -u "\$DOCKER_USERNAME" \
                --password-stdin

            docker pull ${sourceImage}
        """
    }


    /*
     * RETAG IMAGE
     *
     * No Docker build happens here.
     */

    sh """
        docker tag \
            ${sourceImage} \
            ${targetImage}
    """


    /*
     * LOGIN TO TARGET REGISTRY
     * Push the exact same image with the new registry/repository name.
     */

    withCredentials([
        usernamePassword(
            credentialsId: targetCredentials,
            usernameVariable: 'DOCKER_USERNAME',
            passwordVariable: 'DOCKER_PASSWORD'
        )
    ]) {

        sh """
            echo "\$DOCKER_PASSWORD" | docker login \
                docker.io \
                -u "\$DOCKER_USERNAME" \
                --password-stdin

            docker push ${targetImage}
        """
    }


    /*
     * CLEAN LOCAL IMAGES
     */

    sh """
        docker rmi ${sourceImage} || true
        docker rmi ${targetImage} || true
    """


    echo "======================================"
    echo "IMAGE PROMOTION COMPLETED"
    echo "======================================"
}