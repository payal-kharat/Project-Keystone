pipeline {

    agent any

    parameters {

        choice(
            name: 'DEPLOY_ENV',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the environment where you want to deploy'
        )
    }

    environment {

        DEV_REGISTRY =
            "docker.io/payalkharat/jenkins-frontend-dev"

        QA_REGISTRY =
            "docker.io/payalkharat/jenkins-frontend-qa"

        STAGE_REGISTRY =
            "docker.io/payalkharat/jenkins-frontend-uat"

        PROD_REGISTRY =
            "docker.io/payalkharat/jenkins-frontend-prod"


        EKS_CLUSTER = "cluster-1"
        AWS_REGION  = "us-east-1"


        DEV_NAMESPACE   = "dev"
        QA_NAMESPACE    = "qa"
        STAGE_NAMESPACE = "uat"
        PROD_NAMESPACE  = "prod"


        DEV_DOCKER_CREDS   = "dh_cred_dev"
        QA_DOCKER_CREDS    = "dh_cred_qa"
        STAGE_DOCKER_CREDS = "dh_cred_stage"
        PROD_DOCKER_CREDS  = "dh_cred_prod"


        DEPLOY_ENV = "${params.DEPLOY_ENV}"


        FRONTEND_DOCKERFILE =
            "APP-3/react-java-mysql/frontend/Dockerfile"

        FRONTEND_BUILD_CONTEXT =
            "APP-3/react-java-mysql/frontend/"

        FRONTEND_DEPLOYMENT_YAML =
            "APP-3/kube/frontend-deployment.yaml"

        FRONTEND_SERVICE_YAML =
            "APP-3/kube/frontend-service.yaml"

        FRONTEND_INGRESS_YAML =
            "APP-3/kube/ingress.yaml"
    }


    stages {

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()

                    echo "COMMIT ID: ${env.COMMIT_ID}"
                    echo "DEPLOY ENVIRONMENT: ${env.DEPLOY_ENV}"
                }
            }
        }


        stage('Connect to EKS') {

            steps {

                sh """
                    aws eks update-kubeconfig \
                        --name ${EKS_CLUSTER} \
                        --region ${AWS_REGION}

                    kubectl get nodes
                """
            }
        }


        stage('Create Kubernetes Namespaces') {

            steps {

                sh """
                    kubectl get namespace ${DEV_NAMESPACE} \
                    || kubectl create namespace ${DEV_NAMESPACE}

                    kubectl get namespace ${QA_NAMESPACE} \
                    || kubectl create namespace ${QA_NAMESPACE}

                    kubectl get namespace ${STAGE_NAMESPACE} \
                    || kubectl create namespace ${STAGE_NAMESPACE}

                    kubectl get namespace ${PROD_NAMESPACE} \
                    || kubectl create namespace ${PROD_NAMESPACE}
                """
            }
        }


        stage('Build Frontend Image') {

            steps {

                script {

                    def image =
                        "${DEV_REGISTRY}:${COMMIT_ID}"

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'Docker-hub-id'
                    ) {

                        sh """
                            docker build \
                                -f ${FRONTEND_DOCKERFILE} \
                                -t ${image} \
                                ${FRONTEND_BUILD_CONTEXT}

                            docker push ${image}
                        """
                    }

                    echo "FRONTEND IMAGE: ${image}"
                }
            }
        }


        stage('Deploy Frontend - DEV') {

            when {

                expression {
                    env.DEPLOY_ENV == 'dev'
                }
            }

            steps {

                script {

                    deployFrontend(
                        DEV_NAMESPACE,
                        DEV_REGISTRY,
                        FRONTEND_DEPLOYMENT_YAML,
                        FRONTEND_SERVICE_YAML,
                        FRONTEND_INGRESS_YAML
                    )
                }
            }
        }


        stage('Promote Frontend DEV → QA') {

            when {

                expression {
                    env.DEPLOY_ENV == 'qa'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${DEV_REGISTRY}:${COMMIT_ID}",
                        "${QA_REGISTRY}:${COMMIT_ID}",
                        DEV_DOCKER_CREDS,
                        QA_DOCKER_CREDS
                    )
                }
            }
        }


        stage('Deploy Frontend - QA') {

            when {

                expression {
                    env.DEPLOY_ENV == 'qa'
                }
            }

            steps {

                script {

                    deployFrontend(
                        QA_NAMESPACE,
                        QA_REGISTRY,
                        FRONTEND_DEPLOYMENT_YAML,
                        FRONTEND_SERVICE_YAML,
                        FRONTEND_INGRESS_YAML
                    )
                }
            }
        }


        stage('Promote Frontend QA → UAT') {

            when {

                expression {
                    env.DEPLOY_ENV == 'uat'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${QA_REGISTRY}:${COMMIT_ID}",
                        "${STAGE_REGISTRY}:${COMMIT_ID}",
                        QA_DOCKER_CREDS,
                        STAGE_DOCKER_CREDS
                    )
                }
            }
        }


        stage('Deploy Frontend - UAT') {

            when {

                expression {
                    env.DEPLOY_ENV == 'uat'
                }
            }

            steps {

                script {

                    deployFrontend(
                        STAGE_NAMESPACE,
                        STAGE_REGISTRY,
                        FRONTEND_DEPLOYMENT_YAML,
                        FRONTEND_SERVICE_YAML,
                        FRONTEND_INGRESS_YAML
                    )
                }
            }
        }


        stage('Production Approval') {

            when {

                expression {
                    env.DEPLOY_ENV == 'prod'
                }
            }

            steps {

                input(
                    message: "Deploy Frontend ${COMMIT_ID} to PROD?",
                    ok: "Deploy Frontend to PROD"
                )
            }
        }


        stage('Promote Frontend UAT → PROD') {

            when {

                expression {
                    env.DEPLOY_ENV == 'prod'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${STAGE_REGISTRY}:${COMMIT_ID}",
                        "${PROD_REGISTRY}:${COMMIT_ID}",
                        STAGE_DOCKER_CREDS,
                        PROD_DOCKER_CREDS
                    )
                }
            }
        }


        stage('Deploy Frontend - PROD') {

            when {

                expression {
                    env.DEPLOY_ENV == 'prod'
                }
            }

            steps {

                script {

                    deployFrontend(
                        PROD_NAMESPACE,
                        PROD_REGISTRY,
                        FRONTEND_DEPLOYMENT_YAML,
                        FRONTEND_SERVICE_YAML,
                        FRONTEND_INGRESS_YAML
                    )
                }
            }
        }
    }


    post {

        always {

            echo "Cleaning Jenkins workspace..."

            cleanWs()
        }
    }
}


def deployFrontend(
    String namespace,
    String registry,
    String deploymentYaml,
    String serviceYaml,
    String ingressYaml
) {

    def image =
        "${registry}:${env.COMMIT_ID}"


    echo "Namespace : ${namespace}"
    echo "Image     : ${image}"
    echo "Deployment: ${deploymentYaml}"
    echo "Service   : ${serviceYaml}"
    echo "Ingress   : ${ingressYaml}"


    sh """
        kubectl apply \
            -f ${deploymentYaml} \
            -n ${namespace}
    """


    sh """
        kubectl apply \
            -f ${serviceYaml} \
            -n ${namespace}
    """


    sh """
        kubectl apply \
            -f ${ingressYaml} \
            -n ${namespace}
    """


    sh """
        kubectl -n ${namespace} set image \
            deployment/frontend \
            frontend=${image}
    """


    sh """
        kubectl -n ${namespace} rollout status \
            deployment/frontend \
            --timeout=180s
    """


    sh """

        echo "===== DEPLOYMENT ====="

        kubectl get deployment frontend \
            -n ${namespace}


        echo "===== SERVICE ====="

        kubectl get service app3-frontend \
            -n ${namespace}


        echo "===== INGRESS ====="

        kubectl get ingress app3-ingress \
            -n ${namespace}


        echo "===== PODS ====="

        kubectl get pods \
            -n ${namespace} \
            -o wide
    """


    echo "Frontend deployment completed."
    echo "Namespace : ${namespace}"
    echo "Image     : ${image}"
}


def promoteImage(
    String sourceImage,
    String targetImage,
    String sourceCredentials,
    String targetCredentials
) {

    echo "Source : ${sourceImage}"
    echo "Target : ${targetImage}"


    docker.withRegistry(
        'https://index.docker.io/v1/',
        sourceCredentials
    ) {

        sh """
            docker pull ${sourceImage}
        """
    }


    sh """
        docker tag \
            ${sourceImage} \
            ${targetImage}
    """


    docker.withRegistry(
        'https://index.docker.io/v1/',
        targetCredentials
    ) {

        sh """
            docker push ${targetImage}
        """
    }


    sh """
        docker rmi ${sourceImage} || true
        docker rmi ${targetImage} || true
    """


    echo "Image promotion completed."
}